layout {

    focus-ring {
        active-color   "#8da3b9"
        inactive-color "#151515"
        urgent-color   "#b66467"
    }

    border {
        active-color   "#8da3b9"
        inactive-color "#151515"
        urgent-color   "#b66467"
    }

    shadow {
        color "#00000070"
    }

    tab-indicator {
        active-color   "#8da3b9"
        inactive-color "#2d4a66"
        urgent-color   "#b66467"
    }

    insert-hint {
        color "#8da3b980"
    }
}

recent-windows {
    highlight {
        active-color "#8da3b9"
        urgent-color "#b66467"
    }
}
