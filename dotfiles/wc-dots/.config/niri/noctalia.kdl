layout {

    focus-ring {
        active-color   "#a22d3b"
        inactive-color "#fff8f7"
        urgent-color   "#ba1a1a"
    }

    border {
        active-color   "#a22d3b"
        inactive-color "#fff8f7"
        urgent-color   "#ba1a1a"
    }

    shadow {
        color "#00000070"
    }

    tab-indicator {
        active-color   "#a22d3b"
        inactive-color "#c34551"
        urgent-color   "#ba1a1a"
    }

    insert-hint {
        color "#a22d3b80"
    }
}

recent-windows {
    highlight {
        active-color "#a22d3b"
        urgent-color "#ba1a1a"
    }
}
