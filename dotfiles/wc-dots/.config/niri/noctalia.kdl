layout {

    focus-ring {
        active-color   "#f7bb70"
        inactive-color "#18120c"
        urgent-color   "#ffb4ab"
    }

    border {
        active-color   "#f7bb70"
        inactive-color "#18120c"
        urgent-color   "#ffb4ab"
    }

    shadow {
        color "#00000070"
    }

    tab-indicator {
        active-color   "#f7bb70"
        inactive-color "#653e00"
        urgent-color   "#ffb4ab"
    }

    insert-hint {
        color "#f7bb7080"
    }
}

recent-windows {
    highlight {
        active-color "#f7bb70"
        urgent-color "#ffb4ab"
    }
}
