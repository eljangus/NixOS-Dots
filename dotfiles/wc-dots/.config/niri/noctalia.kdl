layout {

    focus-ring {
        active-color   "#c1c3f3"
        inactive-color "#131316"
        urgent-color   "#ffb4ab"
    }

    border {
        active-color   "#c1c3f3"
        inactive-color "#131316"
        urgent-color   "#ffb4ab"
    }

    shadow {
        color "#00000070"
    }

    tab-indicator {
        active-color   "#c1c3f3"
        inactive-color "#5b5e88"
        urgent-color   "#ffb4ab"
    }

    insert-hint {
        color "#c1c3f380"
    }
}

recent-windows {
    highlight {
        active-color "#c1c3f3"
        urgent-color "#ffb4ab"
    }
}
