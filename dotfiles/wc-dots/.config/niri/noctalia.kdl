layout {

    focus-ring {
        active-color   "#e9c16c"
        inactive-color "#17130b"
        urgent-color   "#ffb4ab"
    }

    border {
        active-color   "#e9c16c"
        inactive-color "#17130b"
        urgent-color   "#ffb4ab"
    }

    shadow {
        color "#00000070"
    }

    tab-indicator {
        active-color   "#e9c16c"
        inactive-color "#5b4300"
        urgent-color   "#ffb4ab"
    }

    insert-hint {
        color "#e9c16c80"
    }
}

recent-windows {
    highlight {
        active-color "#e9c16c"
        urgent-color "#ffb4ab"
    }
}
