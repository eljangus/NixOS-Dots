layout {

    focus-ring {
        active-color   "#a9ccd7"
        inactive-color "#121414"
        urgent-color   "#ffb4ab"
    }

    border {
        active-color   "#a9ccd7"
        inactive-color "#121414"
        urgent-color   "#ffb4ab"
    }

    shadow {
        color "#00000070"
    }

    tab-indicator {
        active-color   "#a9ccd7"
        inactive-color "#3a5c65"
        urgent-color   "#ffb4ab"
    }

    insert-hint {
        color "#a9ccd780"
    }
}

recent-windows {
    highlight {
        active-color "#a9ccd7"
        urgent-color "#ffb4ab"
    }
}
